    <string name="cleanup_service_label">KakaoTalk Ad Chat Cleanup</string>
    <string name="cleanup_service_description">When an ad notification is blocked, this service opens the channel chat in KakaoTalk, blocks the channel and leaves the chat room so the ad messages are deleted. It only reads and operates KakaoTalk screens and never collects or transmits screen content.</string>
